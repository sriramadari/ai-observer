{
  "name": "ai-observer",
  "version": "0.2.0",
  "description": "A zero-dependency AI SDK middleware for Node.js: one unified client for OpenAI, Anthropic & Gemini with built-in retries, rate-limit handling, Redis response caching, request tracing, cost tracking, and prompt versioning.",
  "keywords": [
    "ai",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "gpt",
    "unified",
    "gateway",
    "middleware",
    "cache",
    "redis",
    "tracing",
    "observability",
    "cost-tracking",
    "prompt-management",
    "retry",
    "rate-limit",
    "edge",
    "browser"
  ],
  "license": "MIT",
  "author": "sriramadari",
  "homepage": "https://github.com/sriramadari/ai-observer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriramadari/ai-observer.git"
  },
  "bugs": {
    "url": "https://github.com/sriramadari/ai-observer/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
